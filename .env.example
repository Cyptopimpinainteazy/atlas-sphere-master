# Example environment configuration (NO SECRETS)
#
# Copy to `.env` (or `.env.local`) and fill in values.
# Never commit real API keys.

# -----------------------------------------------------------------------------
# Atlas Sphere node RPC (local dev)
# -----------------------------------------------------------------------------
ATLAS_SPHERE_HTTP_ENDPOINT=http://127.0.0.1:9944
ATLAS_SPHERE_WS_ENDPOINT=ws://127.0.0.1:9944

# -----------------------------------------------------------------------------
# External EVM chain RPC overrides (atlas-external-chains)
# -----------------------------------------------------------------------------
# Per-chain override by numeric chain id (preferred).
# You can set either a single URL:
#   ATLAS_EXTERNAL_RPC_URL_<CHAIN_ID>=https://...
# or a comma-separated list (first non-empty is used today):
#   ATLAS_EXTERNAL_RPC_URLS_<CHAIN_ID>=https://primary,https://backup
#
# Examples:
ATLAS_EXTERNAL_RPC_URLS_1=https://eth.llamarpc.com,https://rpc.ankr.com/eth
ATLAS_EXTERNAL_RPC_URL_8453=https://mainnet.base.org
ATLAS_EXTERNAL_RPC_URL_42161=https://arb1.arbitrum.io/rpc

# -----------------------------------------------------------------------------
# Managed JSON-RPC providers with header auth (atlas-sdk HttpRpcClient)
# -----------------------------------------------------------------------------
# The SDK supports sending an API key in a configurable header.
# This is commonly needed for gateway providers (e.g. Tatum uses `x-api-key`).
#
# Single endpoint:
#   <PREFIX>_RPC_URL=https://...
#   <PREFIX>_RPC_API_KEY=...
#   <PREFIX>_RPC_API_KEY_HEADER=x-api-key
#
# Multi-endpoint list:
#   <PREFIX>_RPC_URLS=https://primary,https://backup
#
# Example placeholders (do NOT paste real keys here):
SOLANA_RPC_URL=https://gateway.tatum.io/v4/solana
SOLANA_RPC_API_KEY=
SOLANA_RPC_API_KEY_HEADER=x-api-key

ETHEREUM_RPC_URLS=https://gateway.tatum.io/v4/ethereum,https://rpc.ankr.com/eth
ETHEREUM_RPC_API_KEY=
ETHEREUM_RPC_API_KEY_HEADER=x-api-key

# -----------------------------------------------------------------------------
# Swarm API Authentication and Security
# -----------------------------------------------------------------------------
# Enable or disable authentication for the swarm coordination API
SWARM_API_AUTH_ENABLED=true

# Rate limiting (requests per minute per IP)
SWARM_API_RATE_LIMIT=60

# API Keys for swarm coordination access
# Format: SWARM_API_KEY_<name>=<key>:<permissions>
# Permissions: read, write, admin (comma-separated)
# Example:
# SWARM_API_KEY_dashboard=your-secret-key-here:read,write
# SWARM_API_KEY_admin=admin-secret-key:admin
SWARM_API_KEY_dashboard=
SWARM_API_KEY_admin=

# ============================================
# Bitcoin RPC Configuration (REQUIRED for BTC swaps)
# ============================================
BTC_RPC_PASSWORD=your-secure-btc-rpc-password

# ============================================
# AI/LLM API Keys
# ============================================
OPENROUTER_API_KEY=your-openrouter-api-key
