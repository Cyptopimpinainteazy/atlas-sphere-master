# ============================================================================
# X3 ATLAS SPHERE - ENVIRONMENT CONFIGURATION
# Production deployment environment variables and configuration
# ============================================================================

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

# Rust compilation options
RUST_BACKTRACE=1
RUSTFLAGS="-C target-cpu=native -C opt-level=3"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment mode
SWARM_ENV=production
RUST_LOG=info,swarm_media=debug

# Server configuration
SWARM_SERVER_HOST=0.0.0.0
SWARM_SERVER_PORT=8080
SWARM_ADMIN_PORT=8081
SWARM_METRICS_PORT=8082

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection
DATABASE_URL=postgresql://swarm_user:${DB_PASSWORD}@cloudsql-proxy:5432/swarm_media_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_SSL_MODE=require

# Redis (for caching/pub-sub)
REDIS_URL=redis://redis-master:6379/0
REDIS_CLUSTER_ENABLED=false

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# OpenAI
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_ORG_ID=${OPENAI_ORG_ID}
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_REQUEST_TIMEOUT=60

# Anthropic
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_REQUEST_TIMEOUT=120

# ============================================================================
# IMAGE GENERATION CONFIGURATION
# ============================================================================

# Replicate (Flux, SDXL)
REPLICATE_API_TOKEN=${REPLICATE_API_TOKEN}
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_DEFAULT_MODEL=black-forest-labs/flux-pro
REPLICATE_REQUEST_TIMEOUT=300

# ============================================================================
# VIDEO GENERATION CONFIGURATION
# ============================================================================

# Runway
RUNWAY_API_KEY=${RUNWAY_API_KEY}
RUNWAY_BASE_URL=https://api.runwayml.com/v1
RUNWAY_DEFAULT_MODEL=gen-3-alpha
RUNWAY_REQUEST_TIMEOUT=600

# ============================================================================
# TEXT-TO-SPEECH CONFIGURATION
# ============================================================================

# ElevenLabs
ELEVENLABS_API_KEY=${ELEVENLABS_API_KEY}
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_REQUEST_TIMEOUT=30

# ============================================================================
# SOCIAL MEDIA PLATFORM CONFIGURATION
# ============================================================================

# Twitter / X
TWITTER_API_KEY=${TWITTER_API_KEY}
TWITTER_API_SECRET=${TWITTER_API_SECRET}
TWITTER_BEARER_TOKEN=${TWITTER_BEARER_TOKEN}
TWITTER_ACCESS_TOKEN=${TWITTER_ACCESS_TOKEN}
TWITTER_ACCESS_TOKEN_SECRET=${TWITTER_ACCESS_TOKEN_SECRET}
TWITTER_RATE_LIMIT=300
TWITTER_RATE_WINDOW_MINUTES=15

# Instagram
INSTAGRAM_ACCESS_TOKEN=${INSTAGRAM_ACCESS_TOKEN}
INSTAGRAM_BUSINESS_ACCOUNT_ID=${INSTAGRAM_BUSINESS_ACCOUNT_ID}
INSTAGRAM_RATE_LIMIT=200
INSTAGRAM_RATE_WINDOW_MINUTES=60

# TikTok
TIKTOK_API_KEY=${TIKTOK_API_KEY}
TIKTOK_SECRET=${TIKTOK_SECRET}
TIKTOK_RATE_LIMIT=100
TIKTOK_RATE_WINDOW_MINUTES=60

# YouTube
YOUTUBE_API_KEY=${YOUTUBE_API_KEY}
YOUTUBE_CHANNEL_ID=${YOUTUBE_CHANNEL_ID}
YOUTUBE_RATE_LIMIT=50
YOUTUBE_RATE_WINDOW_MINUTES=60

# LinkedIn
LINKEDIN_API_KEY=${LINKEDIN_API_KEY}
LINKEDIN_ACCESS_TOKEN=${LINKEDIN_ACCESS_TOKEN}
LINKEDIN_ORGANIZATION_ID=${LINKEDIN_ORGANIZATION_ID}
LINKEDIN_RATE_LIMIT=250
LINKEDIN_RATE_WINDOW_MINUTES=15

# Discord
DISCORD_BOT_TOKEN=${DISCORD_BOT_TOKEN}
DISCORD_WEBHOOK_URL=${DISCORD_WEBHOOK_URL}

# Telegram
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}

# Reddit
REDDIT_CLIENT_ID=${REDDIT_CLIENT_ID}
REDDIT_CLIENT_SECRET=${REDDIT_CLIENT_SECRET}
REDDIT_USERNAME=${REDDIT_USERNAME}
REDDIT_PASSWORD=${REDDIT_PASSWORD}

# ============================================================================
# COMPLIANCE & GOVERNANCE CONFIGURATION
# ============================================================================

# GDPR compliance
GDPR_ENABLED=true
GDPR_DATA_RESIDENCY_COUNTRY=EU
GDPR_RETENTION_DAYS=365
GDPR_DPA_SIGNED=true

# CCPA compliance
CCPA_ENABLED=true
CCPA_RETENTION_DAYS=365

# LGPD compliance (Brazil)
LGPD_ENABLED=true
LGPD_RETENTION_DAYS=365

# PDPA compliance (Thailand)
PDPA_ENABLED=true
PDPA_DATA_RESIDENCY_COUNTRIES=TH,SG
PDPA_RETENTION_DAYS=365

# Content moderation
CONTENT_MODERATION_ENABLED=true
REQUIRE_AI_DISCLOSURE=true
REQUIRE_SENSITIVE_CONTENT_APPROVAL=true
REQUIRE_HUMAN_REVIEW_FOR_POLITICAL=true
REQUIRE_HUMAN_REVIEW_FOR_MEDICAL=true

# ============================================================================
# ANALYTICS & MONITORING CONFIGURATION
# ============================================================================

# Google Cloud Monitoring
GOOGLE_CLOUD_MONITORING_ENABLED=true
GOOGLE_PROJECT_ID=${GOOGLE_PROJECT_ID}

# Google Cloud Logging
GOOGLE_CLOUD_LOGGING_ENABLED=true
GOOGLE_LOG_LEVEL=INFO

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=15s

# Tracing
OPENTELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SAMPLER=traceidratio
OTEL_SAMPLER_ARG=0.1

# ============================================================================
# PERFORMANCE & SCALING CONFIGURATION
# ============================================================================

# Concurrency
MAX_CONCURRENT_CAMPAIGNS=50
MAX_AGENTS_PER_CAMPAIGN=100
MAX_CONCURRENT_API_CALLS=100
SCHEDULING_INTERVAL_MS=5000

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=500

# Rate limiting (global)
GLOBAL_RATE_LIMIT_REQUESTS=10000
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT/Authentication
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# API Keys
API_KEY_ROTATION_DAYS=90
REQUIRE_TLS=true
TLS_CERT_PATH=/etc/tls/tls.crt
TLS_KEY_PATH=/etc/tls/tls.key

# CORS
CORS_ALLOWED_ORIGINS=https://atlas-sphere.com,https://*.atlas-sphere.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Cloud Storage backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET=${GOOGLE_BACKUP_BUCKET}

# Database backups
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_SCHEDULE=0 3 * * *  # 3 AM daily
DATABASE_BACKUP_RETENTION_DAYS=30

# ============================================================================
# DEVELOPER / DEBUG CONFIGURATION
# ============================================================================

# Local development overrides (ONLY for dev environment)
# DEV_BYPASS_AUTH=false
# DEV_MOCK_API_RESPONSES=false
# DEV_LOG_FULL_TRACES=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_AB_TESTING=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_DECAY_DETECTION=true
FEATURE_AUTO_OPTIMIZATION=true
FEATURE_AGENT_GOVERNANCE=true
FEATURE_MULTI_LANGUAGE_SUPPORT=true
FEATURE_REGIONAL_TARGETING=true
